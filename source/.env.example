# Copy to .env and fill in — .env itself must never be committed
# (already covered by the root .gitignore's Visual Studio template).

POSTGRES_DB=architecturetoolkit
POSTGRES_USER=architecturetoolkit
POSTGRES_PASSWORD=
ROOT_VOLUME_DIR=
ASPNETCORE_HTTP_PORTS=8080

# Only required if using docker-compose.with-proxy.yml (the
# publicly-trusted, Let's Encrypt overlay). Leave blank if you're using
# docker-compose.with-local-tls.yml instead (ADR-0022) — that one issues
# its own self-signed certificate and doesn't need a domain at all.
DOMAIN=

# The exact origin (scheme://host[:port], no trailing slash) your browser
# will actually use to reach this app. Required regardless of which
# topology you're using below — OpenIddict validates the SPA's
# redirect_uri against an exact, pre-registered list (docker-compose.yml's
# Authentication__RedirectUris__0), and rejects everything else with
# ID2043. Set it to:
#   docker-compose.yml alone (plain HTTP, default):  http://localhost:8080
#   + docker-compose.with-proxy.yml (public domain): https://<same value as DOMAIN above>
#   + docker-compose.with-local-tls.yml (LAN/local): https://localhost, or
#     https://<your LAN IP or hostname> — whichever one you'll actually
#     type into a browser. Only covers one origin; if you'll reach this
#     deployment more than one way (e.g. both "localhost" and a LAN IP),
#     add Authentication__RedirectUris__1, __2, etc. directly in
#     docker-compose.yml for each additional one.
PUBLIC_ORIGIN=http://localhost:8080

# Everything else this app used to need here (database connection
# strings, OpenIddict's Authority/ClientId/Audience, the OpenIddict
# certificate password, SMTP credentials) is now entered once through
# the setup wizard the first time you open the app, and stored encrypted
# inside the app-config Docker volume instead — see docker-compose.yml
# and the "Removing appsettings.json secrets" ADR. When filling in the
# wizard's connection string fields inside this Compose stack, use
# Host=db (not the wizard's own default of Host=localhost, which only
# applies to a bare `dotnet run`), and the POSTGRES_DB/POSTGRES_USER/
# POSTGRES_PASSWORD values you set above.
