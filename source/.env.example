# Copy to .env and fill in — .env itself must never be committed
# (already covered by the root .gitignore's Visual Studio template).

POSTGRES_DB=architecturetoolkit
POSTGRES_USER=architecturetoolkit
POSTGRES_PASSWORD=

# ADR-0003: protects the self-hosted OpenIddict signing/encryption
# certificates persisted in the identity-keys volume. Required — the API
# container throws at startup without it (PersistedCertificateProvisioner).
# Generate one with, e.g., `openssl rand -base64 32`.
AUTH_KEYS_PASSWORD=

# Only required if using docker-compose.with-proxy.yml
DOMAIN=

# ADR-0018: optional. Leave all blank to skip email entirely — the "New
# User" action falls back to showing a copyable invite link instead of
# sending anything. Fill these in to enable real SMTP delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@architecturetoolkit.local
SMTP_FROM_NAME=ArchitectureToolkit
SMTP_USE_SSL_ON_CONNECT=false
